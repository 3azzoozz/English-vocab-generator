# Copy this file to .env and fill in your keys. Do NOT commit .env.

# The planner node (tool-calling) uses Claude, so this is required.
ANTHROPIC_API_KEY=sk-ant-...

# The generation/judging tools use a local Ollama model. Make sure Ollama is
# running and the model is pulled:  ollama pull qwen2.5:3b
# (No key needed for Ollama.)

# Langfuse observability (optional — the agent runs untraced if these are unset).
# Get keys from your Langfuse project settings.
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com
